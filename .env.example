# Aether Configuration Environment Variables
# Copy this to .env and fill in your actual values

# Example API Configuration (based on python-sample/.env.example)
EXAMPLE_VAR=https://api.example.com/api/serviceCall
# For testing, you can use the sandbox:
# EXAMPLE_VAR=https://sandbox.example.com/api/serviceCall

# Example API Authentication
EXAMPLE_VAR=YOUR_EXAMPLE_VAR
EXAMPLE_VAR=1

# Step 3 (Already implemented - Get Business Credit / دریافت اعتبار کسب و کار)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP3

# Step 4 - Convert Example User ID and Pasargad Account Number to IBAN (تبدیل شناسه کاربری  و شماره حساب پاسارگاد به شماره شبا)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP4

# Step 5 - Get Business Information (اطلاعات کسب وکار)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP5

# Step 6 - Get User ID (دریافت شناسه کاربری)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP6

# Step 7 - Add Contact Type (افزودن نوع مخاطب)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP7

# Step 8 - Add Contact (اضافه کردن مخاطب)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP8

# Step 9 - Get Wallet Statement (دریافت صورتحساب کیف پول)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP9

# Step 10 - Get Detailed Account Statement (دریافت صورتحساب حساب تفصیلی)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP10

# Step 11 - Transfer Money to Customers (انتقال وجه به مشتریان)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP11

# Step 12 - Get Business Profile (اطلاعات کسب و کار)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP12

# Step 13 - Transfer Money Between Business Digital Account and User Wallet (انتقال وجه میان حساب دیجیتال کسب و کار و کیف پول همان کاربر)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP13

# Step 14 - Confirm Direct Deposit (تایید کردن افزایش موجودی - پرداخت فاکتور خرید شارژ)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP14

# Step 15 - Direct Deposit (افزایش موجودی مستقیم)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP15

# Step 16 - Get User Profile (دریافت پروفایل کاربر)
EXAMPLE_VAR=0
EXAMPLE_VAR=YOUR_API_KEY_STEP16

# Optional: Additional configuration
# EXAMPLE_VAR=https://sandbox.example.com/api/serviceCall
EXAMPLE_VAR=false

# Server Configuration
AETHER_HOST=127.0.0.1
AETHER_PORT=8000
AETHER_LOG_LEVEL=info
RUST_LOG=info